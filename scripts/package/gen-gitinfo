#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# Generate .gitinfo file containing git metadata for use in RPM packaging
# This file is used by scripts/mkcompile_h when .git directory is not available
#

set -e

# Default output file is .gitinfo in current directory
OUTPUT="${1:-.gitinfo}"

# Try to get git information if .git exists
if [ -d ".git" ] && command -v git >/dev/null 2>&1; then
	# Get commit ID (short form)
	GIT_COMMIT=$(git rev-parse --short=12 HEAD 2>/dev/null || echo "unknown")
	
	# Get status (dirty if there are uncommitted changes)
	if git diff-index --quiet HEAD -- 2>/dev/null && \
	   [ -z "$(git ls-files --others --exclude-standard 2>/dev/null)" ]; then
		GIT_STATUS="clean"
	else
		GIT_STATUS="dirty"
	fi
else
	# No git available - use defaults
	GIT_COMMIT="unknown"
	GIT_STATUS="unknown"
fi

# Write .gitinfo file
# Note: This file is sourced by scripts/mkcompile_h, so use LINUX_ prefixed variables
cat > "$OUTPUT" <<EOF
# Git information for kernel build
# Generated by scripts/package/gen-gitinfo
# This file is sourced by scripts/mkcompile_h when .git directory is not available
LINUX_GIT_COMMIT="$GIT_COMMIT"
LINUX_GIT_STATUS="$GIT_STATUS"
EOF

echo "Generated $OUTPUT with git metadata"
exit 0
